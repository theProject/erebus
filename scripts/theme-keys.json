  "criticalComponents": {
    "$description": "Components that must never show default VS Code blue",
    "patterns": [
      "button.*",
      "badge.*",
      "notification.*",
      "quickInput.*",
      "editorSuggestWidget.*",
      "list.*",
      "menu.*",
      "breadcrumb.*",
      "minimap.*",
      "progressBar.*",
      "activityBar.*",
      "statusBar.*",
      "tab.*",
      "extensionButton.*"
    ]
  },

  "darkThemeRules": {
    "$description": "Rules specific to dark theme validation",
    "forbiddenLargeSurfaceColors": ["#000000"],
    "largeSurfaceKeys": [
      "editor.background",
      "sideBar.background",
      "activityBar.background",
      "panel.background",
      "statusBar.background",
      "titleBar.activeBackground"
    ]
  },

  "lightThemeRules": {
    "$description": "Rules specific to light theme validation",
    "forbiddenLargeSurfaceColors": ["#ffffff"],
    "minContrastRatio": 4.5
  }
}
